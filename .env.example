# ===== Aplicación =====
APP_NAME="Sistema de Turnos Médicos"
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
API_V1_PREFIX=/api/v1
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173
TIMEZONE=America/Argentina/Buenos_Aires
TZ=America/Argentina/Buenos_Aires
LOG_LEVEL=INFO
LOG_JSON=true
REQUEST_ID_HEADER=X-Request-ID
TRUSTED_HOSTS=localhost,127.0.0.1
SECURE_HEADERS=true

# ===== PostgreSQL =====
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=turnos
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/turnos
ALEMBIC_DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/turnos
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false

# ===== Redis / colas =====
REDIS_URL=redis://redis:6379/0
RATE_LIMIT_STORAGE_URL=redis://redis:6379/1
ARQ_REDIS_URL=redis://redis:6379/2

# ===== Autenticación =====
JWT_SECRET_KEY=CHANGE_ME_openssl_rand_hex_48
JWT_ALGORITHM=HS256
JWT_ISSUER=turnos-api
JWT_AUDIENCE=turnos-web
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_COOKIE_NAME=refresh_token
CSRF_COOKIE_NAME=csrf_token
CSRF_HEADER_NAME=X-CSRF-Token
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536
ARGON2_PARALLELISM=2
PASSWORD_MIN_LENGTH=10

# ===== Email / Mailpit =====
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_FROM=no-reply@turnos.local
SMTP_FROM_NAME="Sistema de Turnos"
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24
PASSWORD_RESET_TOKEN_EXPIRE_HOURS=1
NOTIFICATION_MAX_RETRIES=3
NOTIFICATION_RETRY_BACKOFF_SECONDS=60,300,900
REMINDER_LEAD_HOURS=24
REMINDER_MIN_ANTICIPATION_MINUTES=1410

# ===== Rate limits (slowapi) =====
RATE_LIMIT_LOGIN_DNI=5/15minutes
RATE_LIMIT_LOGIN_IP=20/15minutes
RATE_LIMIT_PASSWORD_RESET=3/hour
RATE_LIMIT_VERIFICATION_RESEND=3/hour
RATE_LIMIT_BOOKING=10/hour

# ===== Reglas de negocio =====
APPOINTMENT_DEFAULT_DURATION_MINUTES=30
APPOINTMENT_TOLERANCE_MINUTES=10
CANCELLATION_HORIZON_HOURS=24
BOOKING_HORIZON_DAYS=90
BOOKING_MIN_LEAD_MINUTES=0
SLOT_GRANULARITY_MINUTES=15
RED_USER_RESTRICTION_DAYS=30

# ===== Backup =====
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30

# ===== Docker Compose =====
COMPOSE_PROJECT_NAME=turnos
API_PORT=8000
WEB_PORT=5173
DB_PORT=5432
REDIS_PORT=6379
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# ===== Tests =====
TEST_DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/turnos_test
TEST_REDIS_URL=redis://redis:6379/15
TEST_SMTP_HOST=mailpit
TEST_SMTP_PORT=1025
PYTEST_XDIST_WORKERS=auto

# ===== Frontend =====
VITE_API_URL=http://localhost:8000/api/v1
VITE_APP_NAME="Sistema de Turnos"
VITE_ENABLE_MSW=false

# ===== Seed de desarrollo =====
SEED_ADMIN_EMAIL=admin@turnos.local
SEED_ADMIN_DNI=10000000
SEED_ADMIN_PASSWORD=Admin12345!
